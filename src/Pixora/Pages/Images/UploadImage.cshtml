@page "/Images/Upload"

@model UploadImageModel

<div x-data="images">
    <div x-if="$store.user.isAuthenticated">
        <form x-on:submit.prevent class="max-w-lg mx-auto space-y-4">
            <input type="file" x-ref="file" required />
            <textarea x-model="description" placeholder="Image description" class="w-full border p-2" />
            <input x-model="tags" placeholder="tags comma separated" class="w-full border p-2" />
            <button class="bg-blue-600 text-white px-4 py-2 rounded">Upload</button>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            images('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}