@page "/Posts"

@model PostFeedModel

<div x-data="postList" x-init x-cloak>
    <template x-if="isBusy">
        <div class="flex justify-center items-center h-64">
            <div class="loader ease-linear rounded-full border-8 border-t-8 border-gray-200 h-16 w-16"></div>
        </div>
    </template>
    <template x-if="!isBusy && posts.length > 0">
        <div class="card card-body space-y-4">
            <template x-for="post in posts" :key="post.id">
                <div class="border-b pb-4">
                    <h2 class="text-xl font-semibold" x-text="post.title"></h2>
                    <p class="text-gray-600" x-text="post.content"></p>
                    <a :href="`/posts/${post.id}`" class="text-blue-500 hover:underline">Read more</a>
                </div>
            </template>
        </div>
    </template>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            postList('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName'); 
        });
    </script>
}