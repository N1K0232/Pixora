@inject IWebHostEnvironment environment

@{
    var assembly = Assembly.GetExecutingAssembly();
    var version = assembly.GetAttribute<BuildDateTimeAttribute>(a => a.DateTime.ToString("yyyyMMdd.HHmm"));
    var author = assembly.GetAttribute<AssemblyCompanyAttribute>(a => a.Company);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@($"{ViewData["Title"]} - {environment.ApplicationName}".Trim().TrimStart('-').Trim())</title>

    <partial name="_Favicons" />
    <partial name="_OpenGraph" />

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />

    <script src="~/lib/alpine/cdn.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/marked/marked.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/userNavbar.js" asp-append-version="true"></script>
    <script src="~/js/images.js" asp-append-version="true"></script>
    <script src="~/js/posts/postList.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <img src="~/favicon-32x32.png" class="me-2" width="32" height="32" />
                    @environment.ApplicationName
                </a>
                <div class="ms-auto" x-data="userNavbar" x-init="load()" x-cloak>
                    <template x-if="!isAuthenticated">
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary" href="/Account/Login">Sign In</a>
                            <a class="btn btn-primary" href="/Account/Register">Sign Up</a>
                        </div>
                    </template>
                    <template x-if="isAuthenticated && user">
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                                <img :src="profilePhoto" class="rounded-circle me-2" width="32" height="32" />
                                <span x-text="user.userName"></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout">Logout</a></li>
                            </ul>
                        </div>
                    </template>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer mt-auto">
        <div class="container text-body-secondary">
            <div class="row d-flex flex-wrap justify-content-between align-items-center">
                <div class="align-items-center col d-flex align-items-center">
                    &copy; @author
                    <a class="nav-link nav-link-bottom ps-3" title="Twitter" href="https://twitter.com/N1K0232" target="_blank">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                    <a class="nav-link nav-link-bottom ps-3" title="GitHub" href="https://github.com/N1K0232" target="_blank">
                        <i class="bi bi-github"></i>
                    </a>
                </div>
                <div class="nav col justify-content-end d-flex align-items-center">
                    <small>@version</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>