@page

@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div x-data="images" class="container mt-4">
    <div x-init="getList()" x-cloak class="text-center">
        <div x-show="isBusy" class="text-center my-5">
            <div class="spinner-border"></div>
            <p class="mt-2">Loading...</p>
        </div>
        <div x-show="errorMessage" class="alert alert-danger" x-text="errorMessage"></div>
        <div class="row g-3" x-show="!isBusy && list.length > 0">
            <template x-for="image in list">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card shadow-sm">
                        <img :src="image" class="card-img-top" loading="lazy" />
                    </div>
                </div>
            </template>
        </div>
        <div x-show="!isBusy && list.length === 0" class="text-center text-muted mt-5">No image available</div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            images('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}