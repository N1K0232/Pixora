@page

@model ResetPasswordModel

@{
    var secret = Request.Query["secret"];
    var token = Request.Query["token"];
}

<div x-data="auth" class="auth" x-cloak>
    <div class="text-center wrapper">
        <form x-on:submit.prevent>
            <h3>Reset password</h3>
            <div class="input-box">
                <input type="password" x-model="password" placeholder="Password" required />
            </div>
            <div class="input-box">
                <input type="password" x-model="confirmPassword" placeholder="Confirm password" required />
            </div>
            <div class="col-auto mt-3">
                <button class="btn" type="submit" x-on:click="resetPassword('@secret', '@token')" x-bind:disabled="isBusy">Login</button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}