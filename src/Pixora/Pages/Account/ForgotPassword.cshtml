@page "/Account/ForgotPassword"

@model ForgotPasswordModel

<div x-data="auth" class="auth">
    <div class="text-center wrapper">
        <form x-on:submit.prevent>
            <h3>Forgot password</h3>
            <div class="input-box">
                <input type="email" x-model="email" placeholder="Enter your email address" required />
            </div>
            <div class="col-auto mt-3">
                <button class="btn" type="submit" x-on:click="forgotPassword()" x-bind:disabled="isBusy">Send email</button>
            </div>
        </form>

        <div x-show="errorMessage" x-text="errorMessage" class="text-red-600 mt-2"></div>
        <div x-show="forgotPasswordMessage" x-text="forgotPasswordMessage" class="text-green-600 mt-2"></div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}