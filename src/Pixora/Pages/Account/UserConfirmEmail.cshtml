@page

@model UserConfirmEmailModel

<div x-data="auth">
    <div x-init="confirmEmail('@Request.Query["secret"]', '@Request.Query["token"]')" x-cloak class="max-w-md mx-auto mt-10 text-center">
        <div x-show="isBusy" class="text-gray-500">Verifying your email...</div>
        <div x-show="errorMessage.trim().length === 0" class="text-green-600 font-semibold">Your email has been successfully verified.</div>
        <div x-show="errorMessage" x-text="errorMessage" class="text-red-600 font-semibold"></div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}