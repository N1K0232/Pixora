@page

@model LogoutModel

<div x-data="auth" class="auth">
    <div x-init="logout()" x-cloak>
        <div x-show="!isBusy && errorMessage" x-text="errorMessage" class="text-red-600 mt-2"></div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}