<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="MailKit" Version="4.14.1" />
    <PackageReference Include="OperationResultTools" Version="1.0.33" />
    <PackageReference Include="SimpleTransit.Abstractions" Version="1.0.8" />
    <PackageReference Include="TinyHelpers" Version="3.3.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixora.DataAccessLayer\Pixora.DataAccessLayer.csproj" />
    <ProjectReference Include="..\Pixora.StorageProviders\Pixora.StorageProviders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Messages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Messages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Messages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Messages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
